; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="screen-plaer-godot"
config/version="0.1.2"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/app_icon.png"
boot_splash/bg_color=Color(0.0353, 0.0549, 0.0863, 1)
boot_splash/image="res://assets/app_icon_256.png"
boot_splash/fullsize=false
boot_splash/use_filter=true
boot_splash/minimum_display_time=500

[autoload]

LogService="*res://scripts/app_log.gd"
_mcp_game_helper="*res://scripts/dev_game_helper.gd"

[display]

window/size/borderless=true
window/subwindows/embed_subwindows=false
window/stretch/mode="disabled"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"

[debug]

file_logging/enable_file_logging=true
file_logging/log_path="user://logs/godot.log"
file_logging/max_log_files=5
